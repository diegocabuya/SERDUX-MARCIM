    <metric>count turtles with [serdux-state = "R"]</metric>
    <metric>count turtles with [serdux-state = "D"]</metric>
    <metric>count turtles with [serdux-state = "U"]</metric>
    <metric>count turtles with [serdux-state = "X"]</metric>
    <metric>solcontrol</metric>
    <metric>L</metric>
    <metric>R</metric>
    <metric>I</metric>
    <metric>map [ ag -&gt; [serdux-state] of ag ] sort turtles</metric>
