<!-- BehaviorSpace experiment definitions for the verification runs of ABM-MARCIM (NetLogo 6.4.0).
     Reconstructed on 2026-10-19 from the headers of the exported result tables esc1.csv and esc2_nodos10.csv:
     every parameter value, metric, repetition count and time limit below is read from those files.
     The experiments were originally defined in the BehaviorSpace GUI on a working copy of the deposited model
     file and were not saved separately. Paste the <experiment> elements into the BehaviorSpace section of
     the .nlogo file, or load this file with NetLogo's BehaviorSpace "Import" function. -->
<experiments>
  <experiment name="esc1" repetitions="30" sequentialRunOrder="true" runMetricsEveryStep="true">
    <setup>setup</setup>
